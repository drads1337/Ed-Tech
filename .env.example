VITE_API_BASE_URL=http://localhost:3001
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Docker deploy
# In Docker, frontend talks to backend through Nginx on the same domain.
# Keep this empty for docker-compose builds unless you expose the API separately.
# VITE_API_BASE_URL=
APP_PORT=80

# Backend (also read from repo-root .env when running uvicorn)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
BACKEND_CORS_ORIGINS=http://localhost,http://127.0.0.1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_NAME=Ed-Tech Training Loop
